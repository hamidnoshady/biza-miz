{
  "name": "business-suite-desktop",
  "version": "1.0.98",
  "buildCommit": "unknown",
  "buildId": "development",
  "releaseChannel": "stable",
  "private": true,
  "author": "Business Suite",
  "description": "Standalone Windows installer for the multi-app Business Suite platform — accounting, CRM, growth, websites, and POS without manual infrastructure setup.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "npm run patch:exit-hook",
    "patch:exit-hook": "node scripts/patch-embedded-postgres-exit-hook.js",
    "predist": "npm run patch:exit-hook && node scripts/prepare-wincodesign-cache.js",
    "dist": "npm run verify:runtime && electron-builder --config scripts/windows-signing-config.js",
    "verify:runtime": "node scripts/verify-runtime.js",
    "size": "node ../scripts/report-desktop-size.mjs --output=dist/desktop-size-report.md"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "embedded-postgres": "16.14.0-beta.17",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.businesssuite.desktop",
    "productName": "Business Suite",
    "electronLanguages": [
      "en-US",
      "fa"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "ipc-sender.js",
      "app-paths.js",
      "backend-manager.js",
      "server-supervisor.js",
      "embedded-postgres-exit.js",
      "certificate-manager.js",
      "firewall-manager.js",
      "gateway-manager.js",
      "gateway-ipc-authorization.js",
      "network-interfaces.js",
      "native-printing.js",
      "print-target-guard.js",
      "local-storage.js",
      "logger.js",
      "update-engine.js",
      "update-policy.js",
      "cloud-pane.js",
      "navigation-guard.js",
      "permissions.js",
      "support-companion.js",
      "maintenance-gate.js",
      "smoke-probe.js",
      "desktop-release-public-key.pem",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Business Suite cloud sign-in",
        "schemes": [
          "businesssuite"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Business Suite",
      "menuCategory": "Business Suite",
      "installerIcon": "../public/favicon.ico",
      "uninstallerIcon": "../public/favicon.ico",
      "installerHeaderIcon": "../public/favicon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "guid": "5320e026-ee1c-59ff-8791-650fc03301b4",
      "include": "scripts/installer-cleanup.nsh"
    },
    "extraResources": [
      {
        "from": "../.desktop-runtime",
        "to": "desktop-runtime"
      },
      {
        "from": "../.desktop-runtime/node_modules",
        "to": "desktop-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.desktop-assets/postgresql-tools",
        "to": "postgresql-tools"
      }
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
