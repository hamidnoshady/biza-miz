{
  "name": "business-suite-desktop",
  "version": "1.0.7",
  "buildCommit": "unknown",
  "buildId": "development",
  "releaseChannel": "stable",
  "private": true,
  "author": "Business Suite",
  "description": "Standalone Windows installer for the multi-app Business Suite platform — accounting, CRM, growth, websites, and POS without manual infrastructure setup.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/prepare-wincodesign-cache.js",
    "dist": "npm run verify:runtime && electron-builder --config scripts/windows-signing-config.js",
    "verify:runtime": "node scripts/verify-runtime.js",
    "size": "node ../scripts/report-desktop-size.mjs --output=dist/desktop-size-report.md"
  },
  "dependencies": {
    "embedded-postgres": "16.14.0-beta.17",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.cafepos.desktop",
    "productName": "Business Suite",
    "electronLanguages": [
      "en-US",
      "fa"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "app-paths.js",
      "backend-manager.js",
      "certificate-manager.js",
      "firewall-manager.js",
      "gateway-manager.js",
      "network-interfaces.js",
      "native-printing.js",
      "local-storage.js",
      "logger.js",
      "update-engine.js",
      "cloud-window.js",
      "desktop-release-public-key.pem",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "../public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Business Suite",
      "menuCategory": "Business Suite",
      "installerIcon": "../public/favicon.ico",
      "uninstallerIcon": "../public/favicon.ico",
      "installerHeaderIcon": "../public/favicon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "../.desktop-runtime",
        "to": "desktop-runtime"
      },
      {
        "from": "../.desktop-runtime/node_modules",
        "to": "desktop-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.desktop-assets/postgresql-tools",
        "to": "postgresql-tools"
      }
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
