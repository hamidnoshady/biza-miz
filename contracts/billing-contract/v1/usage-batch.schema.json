{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "billing-contract/v1/usage-batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "contractVersion", "events"],
  "properties": {
    "source": { "const": "eshobe-cms" },
    "contractVersion": { "const": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "usage-event.schema.json" }
    }
  }
}
