# Café laptop (on-site local server) environment — Phase 11.
# Copy to .env on the laptop, fill the values, then:
#   docker compose -f docker-compose.local.yml pull && up -d
# Full guide: docs/server-sync.md

# Which published image/tag to run. Defaults to :latest (whatever's newest on
# main); pin to a release tag (e.g. v1.4.2) once you're past initial setup so
# this laptop only moves versions when you choose to — see docs/server-sync.md
# "Self-update" for how it updates itself afterwards.
# POS_IMAGE=ghcr.io/hamidnoshady/cafe-restaurant-pos
# POS_IMAGE_TAG=latest

# Postgres (the app talks to the db service inside the compose network).
POSTGRES_USER=pos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pos

# Secret used to sign JWT session cookies. Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Owner/Manager session lifetime (hours). Default 12.
SESSION_HOURS=12

# Port the app is published on for LAN devices (http://<laptop-lan-ip>:APP_PORT).
APP_PORT=3000

# Shared bearer token guarding this server's /api/server-sync endpoints.
# Set the SAME value as REMOTE_SYNC_TOKEN on the VPS, and enter it in the
# Owner dashboard's Server Sync config, which generates one for you.
REMOTE_SYNC_TOKEN=

# This is a site, not the central server (Phase 23): the Server Sync tab shows
# the central address as derived read-only text rather than asking for it, and
# the install is allowed to configure a sync target. Set explicitly because
# REMOTE_SYNC_TOKEN above would otherwise make the inference guess "central".
DEPLOYMENT_ROLE=site

# Base URL of the central server this laptop syncs to. Pairing normally fills
# this in per business, so it is only needed on an unpaired install.
# PLATFORM_BASE_URL=https://pos.example.com

# The only permitted cloud channel in a fully Local profile. Values are
# provisioned by support and remain server-side.
# SUPPORT_CLOUD_URL=https://pos.example.com
# SUPPORT_RELAY_TOKEN=
# SUPPORT_INSTALLATION_ID=

# ---------------------------------------------------------------------------
# Eshobe CMS (headless website builder) — see docs/eshobe-cms-integration.md
# ---------------------------------------------------------------------------
# Control-plane origin of the Payload CMS (no trailing slash). The tenant is
# decided by each business's stored site domain + per-site API key, not here.
# ESHOBE_CMS_URL=https://cms.eshobe.com
# Extra origins the dashboard may frame (the website manager's CMS edit modal) when the CMS
# address was saved in the console rather than set above. Comma-separated. The CMS must also
# list THIS dashboard's origin in its ADMIN_EMBED_ORIGINS.
# CMS_EMBED_ORIGINS=
# The CMS's PAYLOAD_SECRET — verifies the HMAC signature on publish webhooks
# POSTed to /api/cms/revalidate. Set it to the same value as the CMS.
# ESHOBE_CMS_WEBHOOK_SECRET=
# Optional operator credential (role: "platform" key) for the provisioning
# endpoints and the whole operator surface /api/platform/* on the CMS.
#
# Since migration 0139 this pair is only the FALLBACK: the super-admin console
# stores the CMS address and this key in `platform_cms_config` (encrypted), so
# «سایت‌ساز → اتصال» is where an operator sets and rotates them. The stored row
# wins when both exist; leave these unset on a new deployment.
# ESHOBE_CMS_PLATFORM_API_KEY=
