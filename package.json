{
  "name": "cafe-restaurant-pos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build --experimental-build-mode compile --experimental-app-only && next build --experimental-build-mode generate --experimental-app-only",
    "desktop:runtime": "node scripts/build-desktop-runtime.mjs",
    "desktop:stage-pg-tools": "node scripts/stage-postgresql-tools.mjs",
    "desktop:stage-pg-tools:release": "node scripts/stage-postgresql-tools.mjs --require",
    "desktop:size": "node scripts/report-desktop-size.mjs",
    "start": "NODE_ENV=production tsx server.ts",
    "deploy:verify": "node scripts/verify-production-deploy.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:design": "vitest run src/app/dashboard/design-lint.test.ts src/app/design-lint.test.ts src/app/dashboard/primitive-lint.test.ts src/app/loading-coverage.test.ts src/app/reference-screenshots.test.ts",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:visual:update": "node scripts/visual-regression.mjs --update",
    "test:e2e:media": "node scripts/e2e-media.mjs",
    "db:dev": "node scripts/dev-postgres.mjs",
    "db:dev:start": "node scripts/dev-postgres.mjs --detach",
    "db:dev:stop": "node scripts/dev-postgres.mjs --stop",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:app-role": "tsx scripts/create-app-role.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:visual": "tsx scripts/seed-visual-fixture.ts",
    "db:seed-knowledge": "tsx scripts/seed-knowledge.ts",
    "db:platform-admin": "tsx scripts/seed-platform-admin.ts",
    "mfa:reset-platform": "tsx scripts/reset-platform-mfa.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:restore-tenant": "tsx scripts/restore-tenant.ts",
    "db:reconcile-opening": "tsx scripts/reconcile-opening-inventory.ts",
    "media:reconcile-orphans": "tsx scripts/media-reconcile-orphans.ts",
    "db:normalize-phones": "tsx scripts/normalize-customer-phones.ts",
    "db:encrypt-fields": "tsx scripts/encrypt-fields.ts",
    "db:encrypt-ai-secrets": "tsx scripts/encrypt-ai-gateway-secrets.ts",
    "inventory:cutover": "tsx scripts/inventory-cutover.ts",
    "deployment:convert-hybrid": "tsx scripts/convert-local-to-hybrid.ts",
    "platform-company:billing-backfill": "tsx scripts/platform-company-billing-backfill.ts"
  },
