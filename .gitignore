node_modules/
.next/
.desktop-runtime/
.desktop-assets/
desktop-size-report.md
backups/
# Build output lives at the repo root. These patterns are anchored with a
# leading slash because the unanchored form matches a directory of that name at
# any depth — and App Router turns every URL segment into a directory, so a
# bare `build/` silently untracked `src/app/api/.../setup/build/route.ts`.
/out/
/build/
/dist/

.env
.env.local
.env*.local

npm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Electron build/packaging output and logs — never committed. electron/dist/
# is the electron-builder output directory (installer artifacts, unpacked
# app); electron/*.log is any captured build log (electron-builder, verify
# scripts). These previously slipped into the repo (electron/build-output.log)
# and inflated checkout size for no reason — packaged artifacts belong in CI
# outputs/releases, not in git.
electron/dist/
electron/*.log
electron/**/*.log

.DS_Store

# design-sync
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Freebuff agent workspace data
.freebuff/

# Plugin release asset built by wordpress-plugin/package-release.sh
wordpress-plugin/pos-accounting-connector.zip

# Visual-regression diff output is a local artifact of a failing run; the
# baselines beside it are committed, the diffs never are.
docs/design/visual/__diff__/

# Desktop build logs are local artifacts of `npm run dist`, never reviewed
# output. One was committed once and went stale against a two-version-old
# electron-builder; ignore the shape so it cannot happen again.
electron/build-output.log

# Local read-only reporting browser-review screenshots (not approved baselines).
.cache/platform-report-smoke/
