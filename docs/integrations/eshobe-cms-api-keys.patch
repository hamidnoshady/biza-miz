+import type { CollectionConfig } from 'payload'
+
+import { platformAdmin } from '../access/platformAdmin'
+
+/**
+ * API keys — the credential a headless consumer (the site builder) presents
+ * as `Authorization: Bearer eshobe_live_…`.
+ *
+ * ## Deliberately NOT in the multi-tenant plugin's `collections` map
+ *
+ * Every other tenant-scoped collection is registered there (see the rule in
+ * CLAUDE.md), but this one is the exception, and it is a deliberate one:
+ * the plugin's only contribution is a tenant constraint for *logged-in
+ * users*, and this collection has no such audience — access is
+ * `platformAdmin` on all four operations, so the admin panel never lists a
+ * key for a customer. What matters here is the *credential* path, which does
+ * not go through this collection's read access at all: `apiKeyAuth`
+ * (`src/access/siteApiKey.ts`) looks the key up with `overrideAccess: true`
+ * and the tenant is derived from the matched row, never from the caller.
+ * Registering it would also force the plugin's `site` field (required) onto
+ * every row, which would make a `role: 'platform'` key — the operator
+ * credential, necessarily site-less — unrepresentable.
+ *
+ * The raw key is never stored. `keyHash` (sha256 hex) is the lookup key;
+ * `prefix` is the first 20 characters, enough for an operator to tell two
+ * keys apart in the admin. `lastUsedAt` is updated by `apiKeyAuth`.
+ */
+export const ApiKeys: CollectionConfig = {
+  slug: 'api-keys',
+  access: {
+    create: platformAdmin,
+    delete: platformAdmin,
+    read: platformAdmin,
+    update: platformAdmin,
+  },
+  admin: {
+    defaultColumns: ['name', 'role', 'prefix', 'lastUsedAt'],
+    description: 'کلید API برای اتصال سازندهٔ سایت. کلید خام فقط هنگام ساخت نمایش داده می‌شود.',
+    group: 'پلتفرم',
+    useAsTitle: 'name',
+  },
+  labels: {
+    singular: 'کلید API',
+    plural: 'کلیدهای API',
+  },
+  fields: [
+    {
+      name: 'name',
+      type: 'text',
+      label: 'نام',
+      required: true,
+      admin: {
+        description: 'مثلاً «اتصال پنل مدیریت» — فقط برای اینکه دو کلید از هم تشخیص داده شوند.',
+      },
+    },
+    {
+      name: 'role',
+      type: 'select',
+      label: 'نقش',
+      required: true,
+      defaultValue: 'site',
+      options: [
+        { label: 'سایت (یکی)', value: 'site' },
+        { label: 'پلتفرم (پروویژن و کلیدها)', value: 'platform' },
+      ],
+      admin: {
+        position: 'sidebar',
+        description: 'سایت: دسترسی کامل به محتوای یک سایت. پلتفرم: ساخت سایت و مدیریت کلیدها.',
+      },
+    },
+    {
+      name: 'site',
+      type: 'relationship',
+      label: 'سایت',
+      relationTo: 'sites',
+      admin: {
+        position: 'sidebar',
+        description: 'فقط برای کلیدهای نقشی «سایت»؛ برای کلید پلتفرم خالی بماند.',
+        condition: (_, siblingData) => siblingData?.role === 'site',
+      },
+      // Enforced at issue time by the endpoint, not by `required: true`: a
+      // platform key must be able to exist without one, and the admin form
+      // hides this field for that role anyway.
+    },
+    {
+      name: 'prefix',
+      type: 'text',
+      label: 'پیشوند',
+      admin: {
+        readOnly: true,
+        position: 'sidebar',
+        description: 'برای تشخیص دو کلید از هم؛ کلید کامل فقط در همان لحظهٔ ساخت نمایش داده می‌شود.',
+      },
+    },
+    {
+      name: 'keyHash',
+      type: 'text',
+      label: 'نشانهٔ کلید',
+      index: true,
+      admin: {
+        readOnly: true,
+        description: 'sha256 کلید — برای همان‌جا که رمز عبور ذخیره نمی‌شود.',
+      },
+    },
+    {
+      name: 'lastUsedAt',
+      type: 'date',
+      label: 'آخرین استفاده',
+      admin: {
+        readOnly: true,
+        position: 'sidebar',
+      },
+    },
+    {
+      name: 'disabledAt',
+      type: 'date',
+      label: 'ابطال شده در',
+      admin: {
+        readOnly: true,
+        position: 'sidebar',
+        description: 'یک کلید ابطال‌شده بلافاصله از کار می‌افتد؛ ردیف برای حسابرسی می‌ماند.',
+      },
+    },
+  ],
+  timestamps: true,
+}
