diff --git a/tests/int/api-keys.int.spec.ts b/tests/int/api-keys.int.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..732509964cc454d091f2a5f56458e9a21a999638
--- /dev/null
+++ b/tests/int/api-keys.int.spec.ts
@@ -0,0 +1,208 @@
+import type { Payload, PayloadRequest } from 'payload'
+
+import { createLocalReq, getPayload } from 'payload'
+import { afterEach, beforeAll, describe, expect, it } from 'vitest'
+
+import config from '@/payload.config'
+import { generateApiKey, hashApiKey } from '@/access/siteApiKey'
+import { idOf } from '@/lib/ids'
+
+/**
+ * Per-site API keys — WAVE-9 slice 9.4.
+ *
+ * What a headless consumer with a `Bearer eshobe_live_…` key may see and do.
+ * The control-plane host is used on purpose: an *anonymous* read there is the
+ * documented fail-open (WAVE-9 §1), which is exactly what a key has to close —
+ * "attached by API" must mean "scoped by credential, not by memory".
+ */
+let payload: Payload
+
+/**
+ * The `api-keys` collection is not in payload-types.ts until `pnpm
+ * generate:types` runs, so call it through a loose alias — same escape the
+ * other dynamic-slug tests use.
+ */
+const api = {
+  create: (args: object) => (payload.create as unknown as (a: unknown) => Promise<Record<string, unknown>>)(args),
+  update: (args: object) => (payload.update as unknown as (a: unknown) => Promise<Record<string, unknown>>)(args),
+  delete: (args: object) => (payload.delete as unknown as (a: unknown) => Promise<Record<string, unknown>>)(args),
+  find: (args: object) =>
+    (payload.find as unknown as (a: unknown) => Promise<{ docs: Record<string, unknown>[] }>)(args),
+}
+
+const acmeId = { value: '' }
+const studioId = { value: '' }
+
+/** Control-plane host: no site resolves from it, so only the key can scope. */
+const CMS_HOST = 'cms.localhost'
+
+const readWithKey = async (
+  collection: string,
+  key: string,
+  where?: Record<string, unknown>,
+): Promise<Record<string, unknown>[]> => {
+  const req = await createLocalReq(
+    {
+      req: {
+        headers: new Headers({ accept: 'application/json', authorization: `Bearer ${key}` }),
+        method: 'GET',
+        url: `http://${CMS_HOST}/api/${collection}`,
+      } as Partial<PayloadRequest>,
+    },
+    payload,
+  )
+  const { docs } = await api.find({ collection, depth: 0, overrideAccess: false, pagination: false, req, where })
+  return docs
+}
+
+const makeKey = async (role: 'site' | 'platform', siteId?: string): Promise<string> => {
+  const key = generateApiKey()
+  await api.create({
+    collection: 'api-keys',
+    data: {
+      name: `${role} test key`,
+      role,
+      site: siteId ?? null,
+      prefix: key.slice(0, 20),
+      keyHash: hashApiKey(key),
+    },
+  })
+  return key
+}
+
+const draftPage = async (slug: string): Promise<void> => {
+  await payload.create({
+    collection: 'pages',
+    data: { title: 'Key draft', slug, site: acmeId.value },
+    draft: true,
+  })
+}
+
+beforeAll(async () => {
+  payload = await getPayload({ config: await config })
+
+  const { docs } = await payload.find({ collection: 'sites', depth: 0, pagination: false })
+  for (const site of docs as { domain: string; id: string }[]) {
+    if (site.domain === 'acme.localhost') acmeId.value = site.id
+    if (site.domain === 'studio.localhost') studioId.value = site.id
+  }
+}, 180_000)
+
+afterEach(async () => {
+  await api.delete({ collection: 'api-keys', where: { name: { equals: 'site test key' } } })
+  await api.delete({ collection: 'api-keys', where: { name: { equals: 'platform test key' } } })
+})
+
+describe('site API keys on the control-plane host', () => {
+  it('see only the key’s own site, where an anonymous read would see everything', async () => {
+    const key = await makeKey('site', acmeId.value)
+
+    const docs = await readWithKey('pages', key)
+    expect(docs.length).toBeGreaterThan(0)
+    for (const doc of docs) expect(idOf(doc.site)).toBe(acmeId.value)
+  })
+
+  it('cannot widen with a where filter naming another site', async () => {
+    const key = await makeKey('site', acmeId.value)
+
+    const docs = await readWithKey('pages', key, { site: { equals: studioId.value } })
+    expect(docs).toHaveLength(0)
+  })
+
+  it('cannot switch sites by switching the Host header', async () => {
+    const key = await makeKey('site', acmeId.value)
+    const req = await createLocalReq(
+      {
+        req: {
+          headers: new Headers({
+            accept: 'application/json',
+            authorization: `Bearer ${key}`,
+            host: 'studio.localhost',
+          }),
+          method: 'GET',
+          url: 'http://studio.localhost/api/pages',
+        } as Partial<PayloadRequest>,
+      },
+      payload,
+    )
+    const { docs } = await api.find({ collection: 'pages', depth: 0, overrideAccess: false, pagination: false, req })
+    for (const doc of docs) expect(idOf(doc.site)).toBe(acmeId.value)
+  })
+
+  it('see drafts (the builder is the editor), anonymous readers do not', async () => {
+    const draftSlug = `key-draft-${Date.now()}`
+    await draftPage(draftSlug)
+    const key = await makeKey('site', acmeId.value)
+
+    const asKey = await readWithKey('pages', key, { slug: { equals: draftSlug } })
+    expect(asKey).toHaveLength(1)
+
+    const anonReq = await createLocalReq(
+      {
+        req: {
+          headers: new Headers({ accept: 'application/json', host: 'acme.localhost' }),
+          method: 'GET',
+          url: 'http://acme.localhost/api/pages',
+        } as Partial<PayloadRequest>,
+      },
+      payload,
+    )
+    const { docs } = await api.find({
+      collection: 'pages',
+      depth: 0,
+      overrideAccess: false,
+      pagination: false,
+      req: anonReq,
+      where: { slug: { equals: draftSlug } },
+    })
+    expect(docs).toHaveLength(0)
+  })
+
+  it('stamp the key’s site on create, ignoring a site named in the payload', async () => {
+    const key = await makeKey('site', acmeId.value)
+    const req = await createLocalReq(
+      {
+        req: {
+          headers: new Headers({ accept: 'application/json', authorization: `Bearer ${key}` }),
+          method: 'POST',
+          url: `http://${CMS_HOST}/api/products`,
+        } as Partial<PayloadRequest>,
+      },
+      payload,
+    )
+
+    const doc = await api.create({
+      collection: 'products',
+      data: { title: 'Key product', price: 1000, trackInventory: false, site: studioId.value },
+      overrideAccess: false,
+      req,
+    })
+
+    expect(idOf(doc.site)).toBe(acmeId.value)
+    await api.delete({ collection: 'products', where: { id: { equals: doc.id } } })
+  })
+})
+
+describe('revoked keys and platform keys', () => {
+  it('a revoked key stops working immediately', async () => {
+    const key = await makeKey('site', acmeId.value)
+    const { docs } = await api.find({ collection: 'api-keys', where: { name: { equals: 'site test key' } } })
+    await api.update({
+      collection: 'api-keys',
+      id: docs[0].id,
+      data: { disabledAt: new Date().toISOString() },
+    })
+
+    const reads = await readWithKey('pages', key)
