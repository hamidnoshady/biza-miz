diff --git a/src/endpoints/apiKeys.ts b/src/endpoints/apiKeys.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b899caa4adc355c5984521283e3f4af9f63132f6
--- /dev/null
+++ b/src/endpoints/apiKeys.ts
@@ -0,0 +1,165 @@
+import type { Endpoint } from 'payload'
+import { APIError } from 'payload'
+
+import { isPlatformAdmin } from '@/access/platformAdmin'
+import { generateApiKey, hashApiKey, isPlatformApiKey } from '@/access/siteApiKey'
+import { idOf, isUuid } from '@/lib/ids'
+
+/**
+ * The HTTP face of API-key lifecycle — WAVE-9 slice 9.4, consumed by the site
+ * builder (a separate deployment) and by the admin.
+ *
+ * Auth on all three: a platform-admin user **or** a `role: 'platform'` API
+ * key. Site keys can never issue or revoke keys — a key that creates keys is
+ * a key that escalates, and this platform's whole §6 rule is "the caller
+ * never names the tenant".
+ *
+ * The casts to `unknown`-args payload calls below exist only until
+ * `pnpm generate:types` adds the `api-keys` collection to
+ * `src/payload-types.ts`; after that they can be dropped.
+ */
+
+const deny = (): Response =>
+  Response.json(
+    { message: 'ساخت و مدیریت کلیدهای API فقط برای مدیر پلتفرم ممکن است.' },
+    { status: 403, headers: { 'cache-control': 'no-store' } },
+  )
+const authorized = async (req: Parameters<Endpoint['handler']>[0]): Promise<boolean> =>
+  isPlatformAdmin(req.user) || (await isPlatformApiKey(req))
+
+export const issueApiKeyEndpoint: Endpoint = {
+  path: '/api-keys/issue',
+  method: 'post',
+  handler: async (req) => {
+    if (!(await authorized(req))) return deny()
+
+    const body = (await req.json?.()) as { name?: unknown; role?: unknown; siteId?: unknown } | undefined
+    if (!body || typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 120) {
+      throw new APIError('نام کلید الزامی است.', 400, undefined, true)
+    }
+    const role = body.role === 'platform' ? 'platform' : body.role === 'site' ? 'site' : null
+    if (!role) throw new APIError('نقش باید «site» یا «platform» باشد.', 400, undefined, true)
+
+    let siteId: null | string = null
+    if (role === 'site') {
+      if (typeof body.siteId !== 'string' || !isUuid(body.siteId)) {
+        throw new APIError('برای کلید نقشی «سایت»، باید شناسهٔ uuid سایت داده شود.', 400, undefined, true)
+      }
+      siteId = body.siteId
+      const { docs } = await req.payload.find({
+        collection: 'sites',
+        depth: 0,
+        limit: 1,
+        pagination: false,
+        overrideAccess: true,
+        req,
+        where: { id: { equals: siteId } },
+      })
+      if (!docs.length) throw new APIError('سایت پیدا نشد.', 404, undefined, true)
+    }
+
+    const key = generateApiKey()
+    const doc = await (
+      req.payload as unknown as { create: (args: unknown) => Promise<Record<string, unknown>> }
+    ).create({
+      collection: 'api-keys',
+      data: {
+        name: body.name.trim(),
+        role,
+        site: siteId,
+        prefix: key.slice(0, 20),
+        keyHash: hashApiKey(key),
+      },
+      overrideAccess: true,
+      req,
+    })
+
+    return Response.json(
+      {
+        // The raw key, exactly once — the admin never shows it again.
+        id: doc.id,
+        key,
+        name: doc.name,
+        prefix: doc.prefix,
+        role: doc.role,
+      },
+      { status: 201, headers: { 'cache-control': 'no-store' } },
+    )
+  },
+}
+
+export const listApiKeysEndpoint: Endpoint = {
+  path: '/api-keys/list',
+  method: 'get',
+  handler: async (req) => {
+    if (!(await authorized(req))) return deny()
+
+    const rawSiteId = String(req.query.siteId ?? '')
+    if (rawSiteId && !isUuid(rawSiteId)) throw new APIError('شناسهٔ سایت نامعتبر است.', 400, undefined, true)
+
+    const { docs } = await (
+      req.payload.find as unknown as (args: unknown) => Promise<{ docs: Record<string, unknown>[] }>
+    )({
+      collection: 'api-keys',
+      depth: 0,
+      limit: 200,
+      overrideAccess: true,
+      req,
+      sort: '-createdAt',
+      where: rawSiteId ? { site: { equals: rawSiteId } } : {},
+    })
+
+    return Response.json({
+      docs: docs.map((doc) => ({
+        id: doc.id,
+        name: doc.name,
+        role: doc.role,
+        prefix: doc.prefix,
+        siteId: idOf(doc.site),
+        lastUsedAt: (doc.lastUsedAt as string | null | undefined) ?? null,
+        disabledAt: (doc.disabledAt as string | null | undefined) ?? null,
+        createdAt: doc.createdAt,
+      })),
+      // `keyHash` is deliberately not serialised — it is the lookup key and
+      // nothing a client or an admin screen needs to see.
+    })
+  },
+}
+
+export const revokeApiKeyEndpoint: Endpoint = {
+  path: '/api-keys/revoke',
+  method: 'post',
+  handler: async (req) => {
+    if (!(await authorized(req))) return deny()
+
+    const body = (await req.json?.()) as { id?: unknown } | undefined
+    if (typeof body?.id !== 'string' || !isUuid(body.id)) {
+      throw new APIError('شناسهٔ uuid کلید الزامی است.', 400, undefined, true)
+    }
+
+    const { docs } = await (
+      req.payload.find as unknown as (args: unknown) => Promise<{ docs: unknown[] }>
+    )({
+      collection: 'api-keys',
+      depth: 0,
+      limit: 1,
+      pagination: false,
+      overrideAccess: true,
+      req,
+      where: { id: { equals: body.id } },
+    })
+    if (!docs.length) throw new APIError('کلید پیدا نشد.', 404, undefined, true)
+
+    await (
+      req.payload as unknown as { update: (args: unknown) => Promise<unknown> }
+    ).update({
+      collection: 'api-keys',
+      id: body.id,
+      data: { disabledAt: new Date().toISOString() },
+      overrideAccess: true,
+      req,
+    })
+
+    return Response.json({ ok: true }, { status: 200, headers: { 'cache-control': 'no-store' } })
+  },
+}
