new file mode 100644
index 0000000000000000000000000000000000000000..3e7ed8371af5a38e538c18451747dd7e5b089183
--- /dev/null
+++ b/src/access/siteApiKey.ts
@@ -0,0 +1,177 @@
+import { createHash, randomBytes } from 'node:crypto'
+import type { Access, CollectionBeforeValidateHook, PayloadRequest } from 'payload'
+
+import { idOf } from '@/lib/ids'
+
+/**
+ * Per-site API keys — WAVE-9 slice 9.4 ("per-site read API keys"), extended
+ * to writes because the site builder (a separate deployment) must be able to
+ * *operate* a customer's site, not only read it.
+ *
+ * ## The rule this exists to keep (WAVE-9 §6)
+ *
+ * "The tenant comes from the socket, or from a credential, never from a filter."
+ *
+ * A key resolves to a site *server-side*: `Authorization: Bearer eshobe_live_…`
+ * is hashed, looked up in `api-keys`, and the site is taken from the row.
+ * The caller never names a tenant — a `where[site][equals]=<other>` filter
+ * intersects with the key's site and yields nothing, exactly like the host
+ * header does for anonymous reads (`src/access/siteRead.ts`).
+ *
+ * ## Roles
+ *
+ * - `role: 'site'` — ONE site: read (including drafts, it is the builder's
+ *   editor) and write (content, catalogue, order status) its own rows. The
+ *   `site` field of anything it creates is overwritten by
+ *   `forceApiKeySite` — the caller cannot place a document on another site.
+ * - `role: 'platform'` — the operator console's credential: provisioning
+ *   (`POST /api/provision-site`) and API-key lifecycle only. It deliberately
+ *   does NOT read site content directly; a platform key has no `site`.
+ *
+ * ## Why this is not a Payload auth strategy
+ *
+ * `customAuth` would make the key a *user*, and WAVE-9 §4.3 is explicit:
+ * "nothing public may authenticate as a shadow user" — a key that can be
+ * placed in a config file must never get `userHasAccessToAllTenants`
+ * semantics or a tenants array the admin panel can edit. Keys are credentials,
+ * users are people; the two stay separate.
+ */
+
+export const API_KEY_PREFIX = 'eshobe_live_'
+
+export interface ApiKeyAuth {
+  role: 'site' | 'platform'
+  /** The key's site — `null` for a platform key. */
+  siteId: null | string
+  keyId: string
+}
+
+const CONTEXT_KEY = 'eshobeApiKeyAuth'
+
+/** 32 random bytes, base64url — the full key never leaves this process except once, at issue. */
+export const generateApiKey = (): string => `${API_KEY_PREFIX}${randomBytes(32).toString('base64url')}`
+
+/** Only the hash is stored — a leaked `api-keys` table is useless. */
+export const hashApiKey = (key: string): string => createHash('sha256').update(key, 'utf8').digest('hex')
+
+export const isSiteApiKey = (auth: null | ApiKeyAuth): auth is ApiKeyAuth & { role: 'site'; siteId: string } =>
+  auth?.role === 'site' && Boolean(auth.siteId)
+
+export const isPlatformApiKey = (req: PayloadRequest): Promise<boolean> =>
+  apiKeyAuth(req).then((auth) => auth?.role === 'platform')
+
+/**
+ * Resolve the request's API key, memoised on `req.context` (one lookup per
+ * request, shared by every collection's access function on it).
+ *
+ * The lookup itself is `overrideAccess: true` for the same reason
+ * `findSiteByHost` is (WAVE-9 §1): it is the lookup that *establishes* the
+ * tenant, nothing tenant-scoped can constrain it.
+ */
+export const apiKeyAuth = async (req: PayloadRequest): Promise<null | ApiKeyAuth> => {
+  const cached = req.context[CONTEXT_KEY] as undefined | null | ApiKeyAuth
+  if (cached !== undefined) return cached
+
+  const header = req.headers?.get?.('authorization')
+  if (!header?.startsWith('Bearer ')) return cache(req, null)
+
+  const key = header.slice('Bearer '.length).trim()
+  if (!key.startsWith(API_KEY_PREFIX)) return cache(req, null)
+
+  // Cast to `unknown`-args until `pnpm generate:types` knows the `api-keys`
+  // collection (the same escape the tests use for dynamic collection slugs).
+  const { docs } = await (
+    req.payload.find as unknown as (args: unknown) => Promise<{ docs: unknown[] }>
+  )({
+    collection: 'api-keys',
+    depth: 0,
+    limit: 1,
+    overrideAccess: true,
+    pagination: false,
+    req,
+    where: { keyHash: { equals: hashApiKey(key) } },
+  })
+
+  const doc = docs[0] as
+    | { id: unknown; role: 'site' | 'platform'; site: unknown; disabledAt: unknown; lastUsedAt: unknown }
+    | undefined
+
+  // A revoked key is a 401-logged miss, not an error, and not a lookup retry.
+  if (!doc || doc.disabledAt) return cache(req, null)
+
+  const auth: ApiKeyAuth = {
+    role: doc.role === 'platform' ? 'platform' : 'site',
+    siteId: doc.role === 'platform' ? null : idOf(doc.site),
+    keyId: String(doc.id),
+  }
+  if (auth.role === 'site' && !auth.siteId) return cache(req, null)
+
+  // `lastUsedAt` is observability, not data — throttled to once a minute per
+  // key so a busy site does not write a row per request. Best effort on top:
+  // a failed write must never break the request it rode in on.
+  if (!doc.lastUsedAt || Date.now() - new Date(String(doc.lastUsedAt)).getTime() > 60_000) {
+    void (req.payload as unknown as { update: (args: unknown) => Promise<unknown> })
+      .update({
+        collection: 'api-keys',
+        id: auth.keyId,
+        data: { lastUsedAt: new Date().toISOString() },
+        overrideAccess: true,
+        req,
+      })
+      .catch(() => {})
+  }
+
+  return cache(req, auth)
+}
+
+const cache = (req: PayloadRequest, value: null | ApiKeyAuth): null | ApiKeyAuth => {
+  req.context[CONTEXT_KEY] = value
+  return value
+}
+
+/**
+ * Read/update/delete access on tenant collections: a site key is confined to
+ * its own site (a where clause, so Payload ANDs it with the collection's own
+ * logic); a platform key is DENIED — its uses are the operator endpoints
+ * (provisioning, key lifecycle), never customer content. No key: the base
+ * access decides, exactly as before.
+ */
+export const apiKeyAware = (base: Access): Access => async (args) => {
+  const auth = await apiKeyAuth(args.req)
+  if (!auth) return base(args)
+  if (auth.role === 'platform') return false
+  return { site: { equals: auth.siteId ?? '' } }
+}
+
+/**
+ * Create access on tenant collections. A where clause is meaningless on
+ * create, so the site key is allowed and `forceApiKeySite` stamps the row's
+ * `site` a moment later — the caller never names the tenant, and a payload
+ * that *does* is overwritten. Platform keys do not create content.
+ */
+export const apiKeyCreateAware = (base: Access): Access => async (args) => {
+  const auth = await apiKeyAuth(args.req)
+  if (!auth) return base(args)
+  if (auth.role === 'platform') return false
+  return true
+}
+
+/** For collections without a `site` field (sites, users, api-keys): platform keys only. */
+export const platformApiKeyAware = (base: Access): Access => async (args) => {
+  const auth = await apiKeyAuth(args.req)
+  if (auth?.role === 'platform') return true
+  return base(args)
+}
+
+/**
+ * `beforeValidate` — runs before field validation, so a `site` field that is
+ * required (the multi-tenant plugin makes it so) is already set when the
+ * document is validated. Create only: updates are already confined by
+ * `apiKeyAware`'s where clause, and never move a document across sites.
+ */
+export const forceApiKeySite: CollectionBeforeValidateHook = async ({ data, operation, req }) => {
+  if (operation !== 'create') return data
+  const auth = await apiKeyAuth(req)
+  if (auth?.role !== 'site' || !auth.siteId) return data
+  return { ...(data ?? {}), site: auth.siteId }
+}
