# Environment for the ParsPack Docker Compose stack (docker-compose.parspack.yml).
#
# ParsPack's Compose apps read variables from a `.env` file you upload in the
# "پارامترها و متغیرها" step, not from a stack UI field-by-field like Komodo —
# see docs/deployment/parspack-deployment.md. Fill this in and upload the filled-in copy
# there; don't commit a filled-in copy to the repo.

# --- Image (required — see docs/deployment/parspack-deployment.md) -----------------------
# ParsPack pulls images, it does not build them. Build this repo's Dockerfile
# yourself and push it somewhere ParsPack can pull from, then point this at
# it, e.g.:
#   docker build -t ghcr.io/<you>/cafe-restaurant-pos:parspack .
#   docker push ghcr.io/<you>/cafe-restaurant-pos:parspack
POS_IMAGE=ghcr.io/<you>/cafe-restaurant-pos:parspack

# --- Secrets --------------------------------------------------------------
# Signs the JWT session cookie. MUST be a real random value in production.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# Password for the bundled Postgres service.
POSTGRES_PASSWORD=change-me-strong-db-password

# Root account for the bundled OpenObserve service (first boot only —
# rotate the password in its own UI afterwards if you like).
OPENOBSERVE_ROOT_EMAIL=ops@example.com
OPENOBSERVE_ROOT_PASSWORD=change-me-strong-observe-password

# --- Postgres (optional overrides) -----------------------------------------
POSTGRES_USER=pos
POSTGRES_DB=pos

# --- Sessions (optional) ----------------------------------------------------
SESSION_HOURS=12

# --- Biometric login (optional) --------------------------------------------
# Only needed if staff use fingerprint/WebAuthn login. Must match the exact
# https:// origin the browser shows.
# WEBAUTHN_ORIGIN=https://pos.example.com

# --- Per-business subdomains (optional — see the phase-23 note in ---------
# docs/deployment/parspack-deployment.md before setting these) --------------------------
# Leave unset for the common case: one business at one domain. Only set these
# to host SEVERAL businesses off this deployment, and only once you have a
# wildcard DNS record + wildcard TLS cert for ROOT_DOMAIN — check ParsPack's
# custom-domain feature supports that before committing to this path.
# ROOT_DOMAIN=pos.example.com
# SUBDOMAIN_ROUTING=on
# PLATFORM_BASE_URL=https://pos.example.com

# --- OpenObserve (optional overrides) ---------------------------------------
# OPENOBSERVE_VERSION=latest
# OPENOBSERVE_RETENTION_DAYS=60
# OPENOBSERVE_ORG=default
# OPENOBSERVE_LOG_STREAM=pos_app_logs
# OPENOBSERVE_SERVICE=pos-parspack
# OPENOBSERVE_ENV=production
# Only needed if you made the `observability` service public in ParsPack and
# want the console's "full dashboard" link to work:
# OPENOBSERVE_PUBLIC_URL=https://obs.example.com
